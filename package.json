{
  "name": "work-log",
  "version": "1.5.0",
  "description": "LiuXu is a local-first personal AI workspace for knowledge, memory, and tasks.",
  "author": "LiuXu Contributors",
  "main": "electron/main.js",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-editor.mjs",
    "start": "npm run build && node server.js",
    "desktop": "npm run build && electron .",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:build:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-build.ps1",
    "desktop:build:win:cross": "node scripts/desktop-build-win-cross.mjs",
    "desktop:build:mac": "node scripts/desktop-build-mac.mjs --adhoc",
    "desktop:release:mac": "node scripts/desktop-build-mac.mjs --release",
    "desktop:icon:mac": "node scripts/build-mac-icon.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "knowledge:migrate-folder": "node scripts/migrate-knowledge-folder.cjs",
    "test:ebook-reader:electron": "node scripts/run-ebook-reader-electron.cjs",
    "test:file-reader:electron": "node scripts/run-file-reader-electron.cjs",
    "test:knowledge-pins:electron": "node scripts/run-knowledge-pins-electron.cjs",
    "test:note-images:electron": "node scripts/run-note-images-electron.cjs",
    "test:mindmap:electron": "node scripts/run-mindmap-electron.cjs",
    "test": "npm run build && node --test --test-concurrency=1",
    "test:note-browser:electron": "node scripts/run-note-browser-electron.cjs",
    "todo:reminder:test": "node scripts/send-todo-reminder-mail.js",
    "test:knowledge-ui:electron": "node scripts/run-knowledge-ui-electron.cjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "better-sqlite3": "^13.0.3",
    "docx-preview": "0.4.1",
    "dompurify": "^3.4.16",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "foliate-js": "1.0.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "marked": "^18.0.3",
    "minisearch": "^7.2.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfjs-dist": "5.4.624",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "body-parser": "^1.20.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "tar": "^7.5.22"
  }
}
